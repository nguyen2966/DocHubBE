NODE_ENV=development
PORT=3000

MONGO_URL=mongodb://mongodb:27017/dochub

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

JWT_SECRET=dev_jwt_secret_change_me
